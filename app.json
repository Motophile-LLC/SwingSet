{
  "expo": {
    "name": "SwingSet",
    "slug": "swingset",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/SSLogo.png",
    "scheme": "swingset",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/SSLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B1464"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.motophile.swingset"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/SSLogo.png",
        "backgroundColor": "#1B1464"
      },
      "package": "com.motophile.swingset",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/SSLogo.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
